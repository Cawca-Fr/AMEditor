<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- ── TOOLBAR ─────────────────────────────────────────────────────── -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            android:title="@string/app_name"
            android:titleTextColor="@color/white"
            app:titleCentered="true"
            app:titleTextAppearance="@style/TextAppearance.AMEditor.Toolbar.Title"
            app:theme="@style/ThemeOverlay.AMEditor.Toolbar"
            app:popupTheme="@style/ThemeOverlay.AMEditor.Popup" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ── SCROLLABLE CONTENT ──────────────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainNestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <!-- ════════════════════════════════════════════════════════
                 CARD 1 — SOURCE FILE
                 Step label + primary SELECT APK button + file info row
                 ════════════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSourceFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Step header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <!-- Step number badge -->
                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:text="1"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnPrimary"
                            android:gravity="center"
                            android:background="@drawable/step_badge_bg"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/card_title_source"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                    </LinearLayout>

                    <!-- Primary SELECT APK button — full width, filled -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/selectApkButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/select_apk_button_text"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_folder_open"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        style="@style/Widget.Material3.Button" />

                    <!-- APK info row — hidden until file selected -->
                    <LinearLayout
                        android:id="@+id/apkInfoBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="10dp"
                        android:paddingHorizontal="2dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <!-- APK name row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📦 "
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/apkNameText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface"
                                android:ellipsize="middle"
                                android:maxLines="1"
                                tools:text="com.example.myapp_v2.apk" />

                        </LinearLayout>

                        <!-- Sizes row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_apk_prefix"
                                android:textSize="11sp"
                                android:textColor="#6B7280" />

                            <TextView
                                android:id="@+id/apkSizeText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="144.5 MB" />

                            <TextView
                                android:id="@+id/apkOutputSizeLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/label_output_prefix"
                                android:textSize="11sp"
                                android:textColor="#6B7280"
                                android:visibility="gone"
                                tools:visibility="visible" />

                            <TextView
                                android:id="@+id/apkOutputSizeText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#16A34A"
                                android:visibility="gone"
                                tools:text="41.2 MB"
                                tools:visibility="visible" />

                            <!-- Spacer -->
                            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_axml_prefix"
                                android:textSize="11sp"
                                android:textColor="#6B7280" />

                            <TextView
                                android:id="@+id/manifestSizeText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="45 KB" />

                            <TextView
                                android:id="@+id/manifestOutputSizeLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/label_output_prefix"
                                android:textSize="11sp"
                                android:textColor="#6B7280"
                                android:visibility="gone"
                                tools:visibility="visible" />

                            <TextView
                                android:id="@+id/manifestOutputSizeText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#16A34A"
                                android:visibility="gone"
                                tools:text="48 KB"
                                tools:visibility="visible" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ════════════════════════════════════════════════════════
                 CARD 2 — MODDING OPTIONS
                 Disabled until APK is selected.
                 Preview + Custom Patch (outlined) | Auto Patch (filled)
                 ════════════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardModding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Step header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:text="2"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnPrimary"
                            android:gravity="center"
                            android:background="@drawable/step_badge_bg"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/card_title_modding"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                    </LinearLayout>

                    <!-- Preview + Custom Patch on same row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/previewButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="@string/btn_preview_xml"
                            android:enabled="false"
                            android:textSize="12sp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="6dp"
                            app:icon="@drawable/ic_visibility"
                            app:iconSize="16dp"
                            app:iconGravity="textStart"
                            app:iconPadding="4dp"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/customPatchButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="@string/btn_custom_patch"
                            android:enabled="false"
                            android:textSize="12sp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="6dp"
                            app:icon="@drawable/ic_edit"
                            app:iconSize="16dp"
                            app:iconGravity="textStart"
                            app:iconPadding="4dp"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                    </LinearLayout>

                    <!-- Auto Patch — primary filled, full width, more prominent -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/processButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/process_apk_button_text"
                        android:enabled="false"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_build"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        style="@style/Widget.Material3.Button" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ════════════════════════════════════════════════════════
                 CARD 3 — SIGNATURE (optional)
                 Checkbox + Info icon | Import button | Status dot
                 ════════════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSignature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Step header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:text="3"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnPrimary"
                            android:gravity="center"
                            android:background="@drawable/step_badge_bg"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/card_title_signature"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                        <!-- Optional badge -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_optional"
                            android:textSize="10sp"
                            android:textColor="#6B7280"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:background="@drawable/badge_optional_bg" />

                    </LinearLayout>

                    <!-- Checkbox row: Sign APK  +  info icon -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <CheckBox
                            android:id="@+id/signCheckBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/sign_apk"
                            android:enabled="false"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:minWidth="0dp" />

                        <ImageButton
                            android:id="@+id/infoButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_info"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/info_icon"
                            android:scaleType="centerInside"
                            android:padding="4dp" />

                    </LinearLayout>

                    <!-- Import key button + status dot on same row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/importKeyButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/import_signature"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:minWidth="0dp"
                            android:paddingHorizontal="4dp"
                            app:icon="@drawable/ic_key"
                            app:iconSize="16dp"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                        <!-- Status badge: dot + text -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginStart="10dp">

                            <!-- Status dot (red when no key, green when loaded) -->
                            <View
                                android:id="@+id/signatureStatusDot"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/status_dot_red"
                                android:layout_marginEnd="5dp" />

                            <TextView
                                android:id="@+id/signatureBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="11sp"
                                android:textColor="#9CA3AF"
                                android:text="@string/label_no_key_locked"
                                android:maxLines="2"
                                android:ellipsize="end" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ════════════════════════════════════════════════════════
                 CARD 4 — OUTPUT LOGS
                 Progress bar (gone when idle) + log console
                 ════════════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/logCard"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!-- Card header -->
                    <LinearLayout
                        android:id="@+id/logHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="6dp">

                        <LinearLayout
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:gravity="center"
                            android:background="@drawable/step_badge_bg"
                            android:layout_marginEnd="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnPrimary" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_output_title"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                        <!-- Line count badge -->
                        <TextView
                            android:id="@+id/logLineCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="2dp"
                            android:textSize="11sp"
                            android:textColor="#9CA3AF"
                            android:visibility="gone"
                            tools:text="12 lines"
                            tools:visibility="visible" />

                        <ImageButton
                            android:id="@+id/logCopyButton"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:src="@drawable/ic_copy"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/desc_copy_logs"
                            android:scaleType="centerInside"
                            android:padding="7dp"
                            android:visibility="gone"
                            app:tint="#9CA3AF"
                            tools:visibility="visible" />

                        <ImageButton
                            android:id="@+id/logClearButton"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:src="@drawable/ic_delete"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/desc_clear_logs"
                            android:scaleType="centerInside"
                            android:padding="7dp"
                            android:visibility="gone"
                            app:tint="#9CA3AF"
                            tools:visibility="visible" />

                    </LinearLayout>

                    <!-- Progress bar — visible only during processing -->
                    <LinearLayout
                        android:id="@+id/progressContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="6dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ProgressBar
                            android:id="@+id/processProgressBar"
                            style="@android:style/Widget.Material.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:indeterminate="true" />

                        <TextView
                            android:id="@+id/progressStepText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textSize="11sp"
                            android:textColor="#6B7280"
                            android:gravity="end"
                            tools:text="Step 3 — Rebuilding APK…" />

                    </LinearLayout>

                    <!-- Separator -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E5E7EB"
                        android:layout_marginHorizontal="16dp" />

                    <!-- Log text area -->
                    <ScrollView
                        android:id="@+id/logScrollView"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:padding="12dp"
                        android:scrollbars="vertical"
                        android:fillViewport="true">

                        <TextView
                            android:id="@+id/logTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/log_placeholder"
                            android:textColor="#9CA3AF" />

                    </ScrollView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
