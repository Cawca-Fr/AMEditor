<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- TOOLBAR -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            android:title="@string/app_name"
            android:titleTextColor="@color/white"
            app:titleCentered="true"
            app:titleTextAppearance="@style/TextAppearance.AMEditor.Toolbar.Title"
            app:theme="@style/ThemeOverlay.AMEditor.Toolbar"
            app:popupTheme="@style/ThemeOverlay.AMEditor.Popup" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ══════════════════════════════════════════════════════════════════
         BANDEAU TAILLES APK & MANIFEST
         ══════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/apkInfoBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:background="#F0F4FF"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <!-- Ligne APK -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_apk_prefix"
                android:textSize="11sp"
                android:textColor="#6B7280" />

            <TextView
                android:id="@+id/apkSizeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#1E3A5F"
                tools:text="144.5 MB" />

            <TextView
                android:id="@+id/apkOutputSizeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/label_output_prefix"
                android:textSize="11sp"
                android:textColor="#6B7280"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/apkOutputSizeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#16A34A"
                android:visibility="gone"
                tools:text="41.2 MB"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Ligne Manifest -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_axml_prefix"
                android:textSize="11sp"
                android:textColor="#6B7280" />

            <TextView
                android:id="@+id/manifestSizeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#1E3A5F"
                tools:text="45 KB" />

            <TextView
                android:id="@+id/manifestOutputSizeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/label_output_prefix"
                android:textSize="11sp"
                android:textColor="#6B7280"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/manifestOutputSizeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#16A34A"
                android:visibility="gone"
                tools:text="48 KB"
                tools:visibility="visible" />
        </LinearLayout>

    </LinearLayout>

    <View
        android:id="@+id/apkInfoDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#C7D7F0"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/apkInfoBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BOUTONS PRINCIPAUX -->
    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/apkInfoDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/selectApkButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="@string/select_apk_button_text"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/previewButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:text="@string/btn_preview_xml"
            android:enabled="false"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/processButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="@string/process_apk_button_text"
            android:enabled="false"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    </LinearLayout>

    <!-- CUSTOM PATCH -->
    <LinearLayout
        android:id="@+id/customPatchContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/buttonContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/customPatchButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_custom_patch"
            android:enabled="false"
            android:textSize="12sp"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

    </LinearLayout>

    <!-- SIGNATURE ROW -->
    <LinearLayout
        android:id="@+id/signatureContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingVertical="4dp"
        app:layout_constraintTop_toBottomOf="@id/customPatchContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <CheckBox
            android:id="@+id/signCheckBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sign_apk"
            android:enabled="false"
            android:ellipsize="end"
            android:maxLines="1"
            android:minWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/importKeyButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="@string/import_signature"
            android:ellipsize="end"
            android:maxLines="1"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <ImageButton
            android:id="@+id/infoButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_info"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/info_icon"
            android:scaleType="centerInside"
            android:padding="4dp" />

    </LinearLayout>

    <!-- BADGE ÉTAT SIGNATURE -->
    <TextView
        android:id="@+id/signatureBadge"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingBottom="4dp"
        android:textSize="11sp"
        android:textColor="#9CA3AF"
        android:text="@string/label_no_key_locked"
        app:layout_constraintTop_toBottomOf="@id/signatureContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BARRE DE PROGRESSION -->
    <LinearLayout
        android:id="@+id/progressContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/signatureBadge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <ProgressBar
            android:id="@+id/processProgressBar"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/progressStepText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="11sp"
            android:textColor="#6B7280"
            android:gravity="end"
            tools:text="Step 3 — Rebuilding APK…" />

    </LinearLayout>

    <!-- ZONE DE LOGS -->
    <androidx.cardview.widget.CardView
        android:id="@+id/logCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/progressContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- En-tête logs -->
            <LinearLayout
                android:id="@+id/logHeader"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:background="#F9FAFB">

                <!-- Titre "OUTPUT" -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_output_title"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#9CA3AF"
                    android:letterSpacing="0.1" />

                <!-- Compteur de lignes -->
                <TextView
                    android:id="@+id/logLineCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="2dp"
                    android:textSize="11sp"
                    android:textColor="#9CA3AF"
                    android:visibility="gone"
                    tools:text="12 lines"
                    tools:visibility="visible" />

                <!-- Copier les logs -->
                <ImageButton
                    android:id="@+id/logCopyButton"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_copy"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/desc_copy_logs"
                    android:scaleType="centerInside"
                    android:padding="7dp"
                    android:visibility="gone"
                    app:tint="#9CA3AF"
                    tools:visibility="visible" />

                <!-- Effacer les logs -->
                <ImageButton
                    android:id="@+id/logClearButton"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_delete"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/desc_clear_logs"
                    android:scaleType="centerInside"
                    android:padding="7dp"
                    android:visibility="gone"
                    app:tint="#9CA3AF"
                    tools:visibility="visible" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5E7EB" />

            <ScrollView
                android:id="@+id/logScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:scrollbars="vertical"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/logTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/log_placeholder"
                    android:textColor="#9CA3AF" />

            </ScrollView>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
